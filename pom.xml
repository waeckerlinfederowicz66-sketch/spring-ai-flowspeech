<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>

	<groupId>io.flowspeech</groupId>
	<artifactId>spring-ai-flowspeech-parent</artifactId>
	<version>0.2.0</version>
	<packaging>pom</packaging>

	<name>Spring AI FlowSpeech</name>
	<description>Spring AI Text-to-Speech provider and starter for FlowSpeech.</description>
	<url>https://flowspeech.io/</url>

	<modules>
		<module>spring-ai-flowspeech-model</module>
		<module>spring-ai-flowspeech-autoconfigure</module>
		<module>spring-ai-flowspeech-starter</module>
		<module>samples/flowspeech-tts-demo</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<spring-ai.version>2.0.0</spring-ai.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>
</project>
